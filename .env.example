
#preproces_corpus
literature_path = "lietarature";
file_res = "txt";
#installer
min_len = 200;
max_len = inf;
# Настройки токенизации и мультиязычности
# =================================================

# Язык по умолчанию для обработки текста
# Варианты: 'en' - английский, 'ru' - русский, 'multilingual' - оба языка, 'auto' - автоматическое определение
DEFAULT_LANGUAGE=auto

# Применять стемминг/лемматизацию
USE_STEMMING=true

# Удалять стоп-слова
REMOVE_STOPWORDS=true

# Минимальная длина токена
MIN_TOKEN_LENGTH=2

# Настройки кэширования (для оптимизации производительности)
# Максимальный размер кэша морфологического анализатора
MORPH_CACHE_SIZE=10000

# Настройки градиентного бустинга (LightGBM для LTR)
# ----------------------------------------------------

# Количество деревьев в модели
N_ESTIMATORS=100

# Максимальная глубина деревьев
MAX_DEPTH=5

# Скорость обучения (learning rate)
LEARNING_RATE=0.1

# Случайное зерно для воспроизводимости результатов
RANDOM_STATE=42

# Настройки расположения файлов и папок
# ---------------------------------------

# Путь к папке с запросами пользователя
QUERIES_DIR=generated_data/json

# Имя файла с запросами
QUERIES_FILE=queries.json